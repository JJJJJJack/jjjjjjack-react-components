{
  "name": "@jjjjjjack/react-components",
  "description": "Not intended for SSR. Takes away the boilerplates of usual and expected html elements behaviours. The styles are toggable and replaceable.",
  "version": "0.1.1",
  "type": "module",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "yalc:reload": "tsup && yalc push --replace"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react": ">=17",
    "react-colorful": "^5.6.1",
    "react-datepicker": "^9.1.0",
    "react-dom": ">=17",
    "react-select": "^5.10.2",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/react": "^19.2.14",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.2.3",
    "esbuild-sass-plugin": "^3.7.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.98.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
